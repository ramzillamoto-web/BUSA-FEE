rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['id', 'monthNum', 'dueDate', 'amount', 'method', 'status'])
        && data.id is number
        && data.monthNum is string && data.monthNum.size() <= 10
        && data.dueDate is string && data.dueDate.size() <= 50
        && data.amount is number && data.amount > 0
        && data.method is string && data.method.size() <= 50
        && (data.status == 'Pending' || data.status == 'Paid')
        && (!('referenceNo' in data) || (data.referenceNo is string && data.referenceNo.size() <= 100))
        && (!('paidAt' in data) || data.paidAt == null || (data.paidAt is string && data.paidAt.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 200))
        && (!('dueDateISO' in data) || (data.dueDateISO is string && data.dueDateISO.size() <= 30));
    }

    function isValidAgreement(data) {
      return data.keys().hasAll(['title', 'payer', 'receiver', 'monthlyPayment', 'totalAmount'])
        && data.title is string && data.title.size() <= 100
        && data.payer is string && data.payer.size() <= 100
        && data.receiver is string && data.receiver.size() <= 100
        && data.monthlyPayment is number && data.monthlyPayment > 0
        && data.totalAmount is number && data.totalAmount > 0
        && (!('receiverMayaNumber' in data) || (data.receiverMayaNumber is string && data.receiverMayaNumber.size() <= 30))
        && (!('receiverMayaName' in data) || (data.receiverMayaName is string && data.receiverMayaName.size() <= 100));
    }

    match /payments/{paymentId} {
      allow read: if isValidId(paymentId);
      allow create, update: if isValidId(paymentId) && isValidPayment(incoming());
      allow delete: if false;
    }

    match /agreements/{agreementId} {
      allow read: if isValidId(agreementId);
      allow create, update: if isValidId(agreementId) && isValidAgreement(incoming());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
